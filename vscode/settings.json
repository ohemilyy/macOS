{
    "liveServer.settings.CustomBrowser": "firefox",
    "editor.suggestSelection": "first",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "gitlens.hovers.currentLine.over": "line",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "sftp.downloadWhenOpenInRemoteExplorer": true,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook",
    },
    "files.autoSave": "onFocusChange",
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left",
    },
    "workbench.iconTheme": "catppuccin-mocha",
    "terminal.external.linuxExec": "alacritty",
    "git.autofetch": true,
    "git.confirmSync": false,
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Menlo, Monaco, monospace",
    "editor.fontSize": 14,
    "editor.lineHeight": 24,
    "editor.letterSpacing": 0.2,
    "editor.fontVariations": false,
    "editor.fontLigatures": true,
    "explorer.confirmDelete": false,
    "window.titleBarStyle": "custom",
    "redhat.telemetry.enabled": false,
    "java.autobuild.enabled": false,
    "java.completion.chain.enabled": true,
    "java.configuration.maven.globalSettings": "",
    "java.inlayHints.parameterNames.enabled": "none",
    "telemetry.telemetryLevel": "off",
    "editor.linkedEditing": true,
    "cSpell.language": "en,fr",
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    "files.associations": {
        "*.conf": "properties",
    },
    "prettier.bracketSameLine": true,
    "prettier.tabWidth": 4,
    "settingsSync.ignoredSettings": ["editor.fontFamily"],
    "editor.largeFileOptimizations": false,
    "liveServer.settings.donotVerifyTags": true,
    "workbench.tree.enableStickyScroll": true,
    "markdown-preview-enhanced.previewTheme": "one-dark.css",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "security.workspace.trust.untrustedFiles": "open",
    "vscode_custom_css.imports": [],
    "background.backgroundBlur": ["0", "0", "0", "0"],
    "background.windowBackgrounds": [
        "${user:home}/.config/vscode/catppuccin-aurora.png",
    ],
    "background.editorBackgrounds": [
        "${user:home}/.config/vscode/catppuccin-aurora.png",
    ],
    "background.sidebarBackgrounds": [
        "${user:home}/.config/vscode/catppuccin-aurora.png",
    ],
    "background.panelBackgrounds": [
        "${user:home}/.config/vscode/catppuccin-aurora.png",
    ],
    "background.backgroundOpacity": [0.2, 0.12, 0.16, 0.14],
    "background.backgroundAlignment": ["Center Center", "Center Center", "Center Right", "Bottom Right"],
    "background.backgroundRepeat": ["No Repeat", "No Repeat", "No Repeat", "No Repeat"],
    "background.backgroundSize": ["Cover", "Cover", "Cover", "Cover"],
    "editor.codeActionsOnSave": {},
    "github.copilot.editor.enableAutoCompletions": true,
    "background.useInvertedOpacity": false,

    "vscord.status.image.large.debugging.key": "https://vscord.catppuccin.com/mocha/debugging.webp",
    "vscord.status.image.large.editing.key": "https://vscord.catppuccin.com/mocha/{lang}.webp",
    "vscord.status.image.large.idle.key": "https://vscord.catppuccin.com/mocha/idle-{app_id}.webp",
    "vscord.status.image.large.notInFile.key": "https://vscord.catppuccin.com/mocha/idle-{app_id}.webp",
    "vscord.status.image.large.viewing.key": "https://vscord.catppuccin.com/mocha/{lang}.webp",
    "vscord.status.image.small.debugging.key": "https://vscord.catppuccin.com/mocha/debugging.webp",
    "vscord.status.image.small.editing.key": "https://vscord.catppuccin.com/mocha/{app_id}.webp",
    "vscord.status.image.small.idle.key": "https://vscord.catppuccin.com/mocha/idle.webp",
    "vscord.status.image.small.notInFile.key": "https://vscord.catppuccin.com/mocha/idle.webp",
    "vscord.status.image.small.viewing.key": "https://vscord.catppuccin.com/mocha/{app_id}.webp",

    "vscord.app.name": "Code",
    "vscord.status.details.text.editing": "📂​​​​ • {workspace}, on: {git_branch}",
    "vscord.status.details.text.viewing": "📂​​​ • {workspace}, on: {git_branch}",
    "vscord.status.details.text.debugging": "🪲 • Debugging: {file_name}{file_extension}",
    "vscord.status.state.text.debugging": "🪲 • Debugging: {workspace}",
    "vscord.status.state.text.editing": "📝​ • {file_name}{file_extension}",
    "vscord.status.state.text.viewing": "📝​ • {file_name}{file_extension}",
    "vscord.status.image.small.editing.text": "VSCode",

    "workbench.productIconTheme": "feather-vscode",
    "workbench.startupEditor": "none",
    "security.workspace.trust.enabled": false,
    "gitlens.codeLens.authors.command": false,
    "npm.exclude": "",

